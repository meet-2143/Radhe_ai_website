        "jsCode": "// Already updated product titles\nconst alreadyUpdated = [\n  \"DAIRY CLUB-KAJU ANJEER ICE CREAM-960ML\",\n  \"RANGOLI-SHRIKHAND KESAR PISTA-350GM\",\n  \"VADILAL-MEETHA PAAN ICE CREAM-100ML\"\n  // ... KEEP YOUR FULL LIST HERE (UNCHANGED)\n];\n\nconst cleanList = alreadyUpdated.map(t => t.trim().toUpperCase());\n\nreturn items.filter(item => {\n  const sheetTitle = (item.json.title || \"\")\n    .toString()\n    .trim()\n    .toUpperCase();\n\n  return !cleanList.includes(sheetTitle);\n});"
